# Copy to .env.local and fill in from the Supabase dashboard
# (Project Settings -> API). Both values are safe to expose in a browser
# bundle — Row Level Security is what actually protects your data.
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx

# NEVER put these in a VITE_ variable — Vite inlines VITE_* into the client
# bundle, so anything here ships to every player's browser:
#   - the Postgres connection string / database password
#   - the service_role key
# Those belong in server-side environments or your shell only.
